[Version]
Signature="$WINDOWS NT$"
Class=USBDevice
ClassGuid={88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider=%QCOM%
DriverVer = 03/08/2023,1.0.2.7
Catalogfile= qdbusb.cat

[Manufacturer]
%QCOM% = QCOM, NTx86, NTamd64

[QCOM.NTx86]

%QDPL%=QdssPort01, USB\VID_2C7C&PID_030B&MI_0D
%QDSS%=QdssPort, USB\VID_2C7C&PID_030B&MI_0C

%QDPL%=QdssPort01, USB\VID_2C7C&PID_0801&MI_0D
%QDSS%=QdssPort, USB\VID_2C7C&PID_0801&MI_0C

;SDX7X
%QDPL%=QdssPort01, USB\VID_2C7C&PID_0122&MI_0D
%QDSS%=QdssPort, USB\VID_2C7C&PID_0122&MI_0C

;SDX55
%QDPL%=QdssPort01, USB\VID_2C7C&PID_0800&MI_0D
%QDSS%=QdssPort, USB\VID_2C7C&PID_0800&MI_0C

;EM061
%QDPL%=QdssPort01, USB\VID_2C7C&PID_0800&MI_07
%QDSS%=QdssPort, USB\VID_2C7C&PID_0800&MI_06

[QCOM.NTamd64]
%QDPL%=QdssPort01, USB\VID_2C7C&PID_030B&MI_0D
%QDSS%=QdssPort, USB\VID_2C7C&PID_030B&MI_0C

%QDPL%=QdssPort01, USB\VID_2C7C&PID_0801&MI_0D
%QDSS%=QdssPort, USB\VID_2C7C&PID_0801&MI_0C

;SDX7X
%QDPL%=QdssPort01, USB\VID_2C7C&PID_0122&MI_0D
%QDSS%=QdssPort, USB\VID_2C7C&PID_0122&MI_0C

;SDX55
%QDPL%=QdssPort01, USB\VID_2C7C&PID_0800&MI_0D
%QDSS%=QdssPort, USB\VID_2C7C&PID_0800&MI_0C

;EM061
%QDPL%=QdssPort01, USB\VID_2C7C&PID_0800&MI_07
%QDSS%=QdssPort, USB\VID_2C7C&PID_0800&MI_06

[QdssPort.NT]
CopyFiles=QdssDriverFiles

[QdssPort01.NT]
CopyFiles=QdssDriverFiles
AddReg = DevFunctionTypeDPL

[QdssPort.hw]
AddReg          = DfxAddReg

[QdssPort1.hw]
AddReg          = DfxAddReg

[DfxAddReg]
HKR,"WDF","WdfDirectedPowerTransitionEnable",0x00010001,1

[QdssPort.NT.Services]
Addservice = qdbusb, 0x00000002, QdssService

[QdssPort01.NT.Services]
Addservice = qdbusb, 0x00000002, QdssService

[QdssService]
DisplayName    = %qdbusbService%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\qdbusb.sys
LoadOrderGroup = Base

[QdssDriverFiles]
qdbusb.sys

[SourceDisksNames]
1=%Disk_Description%,,,

[SourceDisksFiles.x86]
qdbusb.sys = 1,\qdss\i386
;wdfcoinstaller01009.dll=1,\qdss\i386

[SourceDisksFiles.amd64]
qdbusb.sys = 1,\qdss\amd64
;wdfcoinstaller01009.dll=1,\qdss\amd64

[DestinationDirs]
DefaultDestDir = 12
;CoInstaller_CopyFiles = 11

[DevFunctionTypeDPL]
;HKR,,QCDeviceFunction,0x00010001,1
HKR,,QCDeviceFunction,0x00010001,0

; WDF Coinstaller

;[QdssPort.NT.CoInstallers]
;AddReg=CoInstaller_AddReg
;CopyFiles=CoInstaller_CopyFiles

;[QdssPort01.NT.CoInstallers]
;AddReg=CoInstaller_AddReg
;CopyFiles=CoInstaller_CopyFiles

;[CoInstaller_CopyFiles]
;wdfcoinstaller01009.dll

;[CoInstaller_AddReg]
;HKR,,CoInstallers32,0x00010000, "wdfcoinstaller01009.dll,WdfCoInstaller"

;[QdssPort.NT.Wdf]
;KmdfService = qdbusb, qdbusb_wdfsect

;[QdssPort01.NT.Wdf]
;KmdfService = qdbusb, qdbusb_wdfsect

;[QdssPort.NT.Wdf]
;KmdfService = qdbusb

;[QdssPort01.NT.Wdf]
;KmdfService = qdbusb

;[qdbusb_wdfsect]

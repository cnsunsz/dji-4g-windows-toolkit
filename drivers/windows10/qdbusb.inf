[Strings]
QcClassName     = "QUECTEL USB Devices"
QCOM            = "QUECTEL"
MfgName         = "QUECTEL Inc."
Disk_Description= "QDSS Driver Installation Disk"
qdbusbService = "QDSS USB Driver"

QDPL = "Quectel DPL Data"
QDSS = "Quectel QDSS Data"
